{
  "manifest_version": 3,
  "name": "SkipShorts",
  "version": "1.4.0",
  "description": "Removes YouTube Shorts and Facebook Reels, plus ads, suggested posts and other feed clutter on Facebook and X.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "css": [
        "src/youtube.css"
      ],
      "js": [
        "src/settings.js",
        "src/youtube.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.facebook.com/*"
      ],
      "css": [
        "src/facebook.css"
      ],
      "js": [
        "src/settings.js",
        "src/facebook.js"
      ],
      "run_at": "document_start"
    }
  ],
  "optional_host_permissions": [
    "*://*.x.com/*"
  ]
}
