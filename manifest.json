{
  "manifest_version": 3,
  "name": "SkipShorts",
  "version": "1.0.0",
  "description": "Removes Shorts from YouTube and Reels from Facebook feeds.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["src/youtube.css"],
      "js": ["src/settings.js", "src/youtube.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.facebook.com/*"],
      "css": ["src/facebook.css"],
      "js": ["src/settings.js", "src/facebook.js"],
      "run_at": "document_start"
    }
  ]
}
